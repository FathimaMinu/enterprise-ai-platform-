# ============================================================
# Enterprise AI Platform — Environment Variables
# Copy this file to .env and fill in your values.
# NEVER commit a filled .env to version control.
# ============================================================

# ---- JWT -------------------------------------------------------
# Generate a strong secret: openssl rand -hex 64
JWT_SECRET=change-me-to-a-long-random-hex-string-at-least-64-chars

# ---- OpenAI ----------------------------------------------------
OPENAI_API_KEY=sk-...your-openai-key-here...

# ---- Database (PostgreSQL — used in prod profile) --------------
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/enterpriseai
SPRING_DATASOURCE_USERNAME=enterpriseai
SPRING_DATASOURCE_PASSWORD=change-me-strong-password

# ---- CORS ------------------------------------------------------
# Comma-separated list of allowed frontend origins
CORS_ALLOWED_ORIGINS=http://localhost:5173

# ---- Frontend --------------------------------------------------
VITE_API_URL=http://localhost:8080/api

# ---- Python AI Service -----------------------------------------
AI_SERVICE_URL=http://localhost:8000
